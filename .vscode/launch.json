{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/source/App.pyw",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Lightroom App",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/source/LightroomApp.pyw",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["${input:editInImagePath}"],
      "justMyCode": true
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "editInImagePath",
      "type": "promptString",
      "description": "Path to the image file Lightroom passes on Edit In",
      "default": "C:\\path\\to\\scan.tif"
    }
  ]
}
